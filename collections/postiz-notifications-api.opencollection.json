{
  "opencollection": "1.0.0",
  "info": {
    "name": "Postiz Public Analytics Notifications API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Notifications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List notifications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.postiz.com/public/v1/notifications",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Zero-based page number."
              }
            ]
          },
          "docs": "Returns account notifications, paginated."
        }
      ]
    }
  ],
  "bundled": true
}